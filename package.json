{
  "name": "@matekit/react",
  "version": "0.0.0",
  "description": "Librería de componentes React basada en Material 3 Expressive",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jrodrigopuca/matekit.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "tokens": "node scripts/build-tokens.ts",
    "icons": "node scripts/build-icons.ts",
    "shapes": "node scripts/build-shapes.ts",
    "icons:fetch": "node scripts/fetch-icons.ts && node scripts/build-icons.ts",
    "typecheck": "tsc -p .",
    "lint:css": "node scripts/lint-css.ts",
    "test": "pnpm test:tokens && pnpm test:browser",
    "test:tokens": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@material/material-color-utilities": "0.4.0",
    "@types/node": "26.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
